# Vouta Server — Environment Variables
# Copy this file to .env and fill in your values

# ─── PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/vouta

# ─── JWT ──────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_before_production
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins (all *.vercel.app origins are also allowed automatically)
CORS_ORIGIN=https://vouta-da89.vercel.app,http://localhost:3000

