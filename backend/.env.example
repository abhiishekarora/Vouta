# Vouta Server — Environment Variables
# Copy this file to .env and fill in your values

# ─── PostgreSQL ───────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/vouta

# ─── JWT ──────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Server ───────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins (exact match only; no wildcards)
CORS_ORIGIN=http://localhost:3000


# ─── Email (password reset) ───────────────────────────────────────
# Resend API key (https://resend.com). Leave empty in development: reset links are printed to the console.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Vouta <no-reply@yourdomain.in>
MAIL_FROM=
# Frontend URL used in the emailed reset link (no trailing slash)
APP_URL=http://localhost:3000
